# ── REGISTER AT: propublica.org/datastore/api/propublica-congress-api ──────────
PROPUBLICA_API_KEY=

# ── REGISTER AT: api.data.gov/signup ───────────────────────────────────────────
#    (test instantly with the value DEMO_KEY before your real key arrives)
FEC_API_KEY=

# ── REGISTER AT: api.congress.gov/sign-up ──────────────────────────────────────
CONGRESS_GOV_API_KEY=

# ── REGISTER AT: console.cloud.google.com → Civic Information API ──────────────
GOOGLE_CIVIC_API_KEY=

# ── REGISTER AT: openstates.org/accounts/signup ────────────────────────────────
OPEN_STATES_API_KEY=

# ── REGISTER AT: votesmart.org/share/api  (1–3 business days) ─────────────────
VOTESMART_API_KEY=

# ── REGISTER AT: opensecrets.org/api/admin/index.php?function=signup ───────────
OPENSECRETS_API_KEY=

# ── REGISTER AT: newsapi.org/register ──────────────────────────────────────────
NEWS_API_KEY=

# ── REGISTER AT: alphavantage.co/support/#api-key  (email only, instant) ───────
ALPHA_VANTAGE_API_KEY=

# ── REGISTER AT: fred.stlouisfed.org/docs/api/api_key.html  (instant) ──────────
FRED_API_KEY=

# ── REGISTER AT: api.census.gov/data/key_signup.html  (instant) ────────────────
CENSUS_API_KEY=

# ── REGISTER AT: legiscan.com/legiscan ─────────────────────────────────────────
LEGISCAN_API_KEY=

# ── REGISTER AT: console.anthropic.com ─────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── REGISTER AT: supabase.com ──────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ── NO KEY NEEDED — paste these as-is ──────────────────────────────────────────
SENATE_STOCK_WATCHER_URL=https://senatestockwatcher.com/api/senate-trading
HOUSE_STOCK_WATCHER_URL=https://housestockwatcher.com/api/transactions
GOVTRACK_API_URL=https://www.govtrack.us/api/v2
USA_SPENDING_API_URL=https://api.usaspending.gov/api/v2
FEDERAL_REGISTER_API_URL=https://www.federalregister.gov/api/v1
VOTEVIEW_API_URL=https://voteview.com/api
GDELT_API_URL=https://api.gdeltproject.org/api/v2
COURT_LISTENER_API_URL=https://www.courtlistener.com/api/rest/v3
